# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional feature flags
FEATURE_CRAWL_ENABLED=false
FEATURE_VISUAL_DIFF=true
FEATURE_FUNCTIONAL_QA=true
FEATURE_DATA_INTEGRITY=true
FEATURE_SEO_VALIDATION=true
FEATURE_PERF_METRICS=true
FEATURE_UI_INTEGRITY=true
FEATURE_ACCESSIBILITY_CHECKS=true
FEATURE_SECURITY_HEADERS=true
## Default: AI reasoning is OFF. Set to 'true' to enable globally.
FEATURE_AI_REASONING=false
FEATURE_MULTI_VIEWPORT=true

# Comparison thresholds
PIXEL_DIFF_THRESHOLD=0.1
TEXT_SIMILARITY_WARN=0.85
TEXT_SIMILARITY_FAIL=0.7
PERF_REGRESSION_WARN_PERCENT=20

# Core Web Vitals overrides
WV_LCP_GOOD=2500
WV_LCP_POOR=4000
WV_FCP_GOOD=1800
WV_FCP_POOR=3000
WV_INP_GOOD=200
WV_INP_POOR=500
WV_CLS_GOOD=0.1
WV_CLS_POOR=0.25
WV_TTFB_GOOD=800
WV_TTFB_POOR=1800
