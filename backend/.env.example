### Example environment variables for local development
# Azure OpenAI (preferred)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# Generic OpenAI-compatible endpoint (optional)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5-mini

# Global toggle to enable AI reasoning regardless of per-run settings
ENABLE_AI_REASONING=false

# Data dir override (optional)
DATA_DIR=# Azure OpenAI (preferred)
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# Generic OpenAI-compatible endpoint (alternative)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4

# Feature flags
# Default: AI reasoning is OFF. Set to 'true' to enable globally.
FEATURE_AI_REASONING=false
FEATURE_UI_INTEGRITY=true
FEATURE_SEO_VALIDATION=true
FEATURE_PERF_METRICS=true

# Playwright/runner
PORT=4000
